MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/dbName
MONGO_DEBUG_MODE_ENABLED=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SENDGRID_API_KEY=
