# all env vars currently available
NODE_ENV=production
LOG_LEVEL=info
PORT=4000
JWT_EXPIRE=7d
JWT_SECRET=secret
FIREBASE_API_KEY=someapikey
FIREBASE_PROJECT_ID=project-id
FIREBASE_PRIVATE_KEY="---some long private key---\n; commass are required here"
FIREBASE_CLIENT_EMAIL=firebase-someone@domain.com
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/dbName
MONGO_DEBUG_MODE_ENABLED=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
