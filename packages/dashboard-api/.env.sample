# all env vars currently available
NODE_ENV=production
LOG_LEVEL=info
APP_URI=
PORT=4000
JWT_EXPIRE=7d
JWT_SECRET=secret
FIREBASE_API_KEY=someapikey
FIREBASE_PROJECT_ID=project-id
